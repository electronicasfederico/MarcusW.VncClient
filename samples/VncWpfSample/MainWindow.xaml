<Window x:Class="VncWpfSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VncWpfSample"
        mc:Ignorable="d"
        Title="VNC Viewer" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image x:Name="VncImage" Stretch="Uniform" />
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10" >
            
            <StackPanel Orientation="Vertical">
                <TextBlock Foreground="Red" Text="{Binding InterruptionCause, StringFormat=Error: \{0\}}"
                    />
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="{Binding ConnectionState, FallbackValue=Status,  StringFormat=Status: \{0\}}" />

                    <TextBlock
                 Text="{Binding _connection.UsedSecurityType.Name, FallbackValue=Security, StringFormat=Security Type: \{0\}}" />
                    <TextBlock Text="{Binding _connection.DesktopName, FallbackValue=desktoname, StringFormat=Desktop Name: \{0\}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding _connection.RemoteFramebufferSize, FallbackValue=RemoteFramebufferSize, StringFormat=Remote Framebuffer Size: \{0\}}" />
                    <TextBlock
                 Text="{Binding _connection.RemoteFramebufferFormat.Name, StringFormat=Remote Framebuffer Format: \{0\}}" />
                    <TextBlock
                 Text="{Binding _connection.RemoteFramebufferLayout.Count, StringFormat=Screens: \{0\}}" />
                    <TextBlock
                 Text="{Binding _connection.ContinuousUpdatesEnabled, StringFormat=Continuous Updates: \{0\}}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Foreground="Red" TextWrapping="Wrap"
                Text="The TurboJPEG library is not installed on the current system, therefore the Tight encoding type is unavailable. Please install it and restart the application to get better performance." />
        </StackPanel>
    </Grid>
</Window>
